<%- include('./includes/head', {title: title}) %>

  <div class="container">
    <h2>
      <%= title %>
    </h2>
    <div class="d-flex flex-row justify-content-between">
      <% orders.forEach((order, idx)=> { %>
        <div class="card border-primary m-2 col-4">
          <div class="card-header">
            <h3>
              <%= order.customer %>
            </h3>
          </div>
          <div class="card-body">
            <p>Total: $<%= order.total %>
            </p>
            <p>Items: <% order.items.forEach(item=> {
                %><span class="badge bg-secondary">
                  <%= products.find(product => String(product._id) === String(item.productId))?.name %> (x<%= item.quantity %>)
                </span>
                <% }) %>
            </p>
            <p>Date: <%= new Date(order.date).toLocaleDateString('en-US', { year: 'numeric' , month: '2-digit' ,
                day: '2-digit' }) %>
            </p>
          </div>

        </div>
        <% }) %>
          </ul>

          <%- include('./includes/footer') %>