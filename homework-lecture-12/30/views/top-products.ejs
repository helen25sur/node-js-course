<%- include('./includes/head', {title: title}) %>

  <div class="container">
    <h2>
      <%= title %>
    </h2>
    <ul class="list-group">
      <% topProducts.forEach((product)=> { %>
        <li class="list-group-item d-flex justify-content-between align-items-center">
          <%= product.name %>
            <span class="badge bg-primary rounded-pill">
              <%= product.totalSold %>
            </span>
        </li>
        <% }) %>
    </ul>

    <%- include('./includes/footer') %>