<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="/styles.css">
  </head>
  <body>
    <main>
      <div class="container">
        <h1>All Customers</h1>
        <table class="users-table">
          <thead>
            <tr>
              <th>User Name</th>
              <th>Company</th>
              <th>Age</th>
              <th>Phone Number</th>
              <th>Email</th>
              <th>Country</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            {% for user in users %}
              <tr>
                <td>{{ user.name.first }}
                  {{ user.name.last }}</td>
                <td>{{ user.job.company }}</td>
                <td>{{ user.age }}</td>
                <td class="phone">{{ user.phoneVariation }}</td>
                <td>{{ user.emails }}</td>
                <td>{{ user.location.country }}</td>
                <td class={{ user.status }}>
                  <span>{{ user.status }}</span>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
        <div class="pagination">
          <p class="note">
            Showing data {{ (currentPage - 1) * 10 + 1 }} to {{ (currentPage - 1) * 10 + users.length }} of
            {{ commonLength }} entries
          </p>
          <ul class="pagination-list">
            {% if currentPage > 1 %}
              <li>
                <a href="/?page={{ currentPage - 1 }}">Prev</a>
              </li>
            {% endif %}
            {% for val in range(1, totalPages + 1) %}
              {% if val == currentPage %}
                <li class="active">
                  <a href="/?page={{ val }}">{{ val }}</a>
                </li>
              {% else %}
                <li>
                  <a href="/?page={{ val }}">{{ val }}</a>
                </li>
              {% endif %}
            {% endfor %}
            {% if currentPage < totalPages %}
              <li>
                <a href="/?page={{ currentPage + 1 }}">Next</a>
              </li>
            {% endif %}
          </ul>
        </div>
      </div>
    </main>
  </body>
</html>